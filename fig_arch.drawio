<mxfile host="app.diagrams.net" modified="2026-10-27T12:00:00.000Z" agent="Antigravity" version="21.0.0" type="device"><diagram id="ForgeryNet_Arch" name="Fig. 1 ForgeryNet Architecture"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="grp_dual" value="&lt;b&gt;DUAL-STREAM RESIDUAL EXTRACTOR&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=6;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#0F172A;fontSize=13;fontStyle=1;align=center;verticalAlign=top;startSize=30;collapsible=0;" parent="1" vertex="1"><mxGeometry x="30" y="40" width="310" height="470" as="geometry" /></mxCell><mxCell id="grp_encoder" value="&lt;b&gt;DENSENET-121 HIERARCHICAL BACKBONE ENCODER&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=6;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=1.5;fontColor=#166534;fontSize=13;fontStyle=1;align=center;verticalAlign=top;startSize=30;collapsible=0;" parent="1" vertex="1"><mxGeometry x="370" y="40" width="390" height="470" as="geometry" /></mxCell><mxCell id="grp_attn" value="&lt;b&gt;SPATIAL SELF-ATTENTION BOTTLENECK&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=6;fillColor=#FEFCE8;strokeColor=#FDE047;strokeWidth=1.5;fontColor=#854D0E;fontSize=13;fontStyle=1;align=center;verticalAlign=top;startSize=30;collapsible=0;" parent="1" vertex="1"><mxGeometry x="790" y="40" width="360" height="470" as="geometry" /></mxCell><mxCell id="grp_heads" value="&lt;b&gt;MULTI-TASK PREDICTION HEADS (BRANCH 1 &amp;amp; BRANCH 3)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=6;fillColor=#FAF5FF;strokeColor=#D8B4FE;strokeWidth=1.5;fontColor=#6B21A8;fontSize=13;fontStyle=1;align=center;verticalAlign=top;startSize=30;collapsible=0;" parent="1" vertex="1"><mxGeometry x="1180" y="40" width="750" height="470" as="geometry" /></mxCell><mxCell id="grp_decoder" value="&lt;b&gt;BRANCH 2: STROKE-LEVEL LOCALIZATION U-NET DECODER (4-STAGE WITH SKIP CONNECTIONS)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=6;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.5;fontColor=#1E40AF;fontSize=13;fontStyle=1;align=center;verticalAlign=top;startSize=30;collapsible=0;" parent="1" vertex="1"><mxGeometry x="30" y="650" width="1900" height="420" as="geometry" /></mxCell><mxCell id="c_input" value="&lt;b&gt;High-Res Document Patch&lt;/b&gt;&lt;br&gt;&lt;font size='3'&gt;&lt;b&gt;X&lt;/b&gt; ∈ ℝ&lt;sup&gt;3 × 512 × 512&lt;/sup&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B' size='1'&gt;Native Scan Fidelity (100% DPI)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;fontColor=#0F172A;fontSize=11;" parent="1" vertex="1"><mxGeometry x="50" y="85" width="270" height="65" as="geometry" /></mxCell><mxCell id="c_stream_rgb" value="&lt;b&gt;Stream A: Visual Appearance&lt;/b&gt;&lt;br&gt;&lt;font size='2'&gt;&lt;b&gt;X&lt;/b&gt; ∈ ℝ&lt;sup&gt;3 × 512 × 512&lt;/sup&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#0369A1' size='1'&gt;Photometric Character Stroke Morphology&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=1.5;fontColor=#0369A1;fontSize=11;" parent="1" vertex="1"><mxGeometry x="50" y="185" width="270" height="65" as="geometry" /></mxCell><mxCell id="c_hpf_kernel" value="&lt;b&gt;Depthwise Laplacian Filter Kernel&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' size='2'&gt;&lt;b&gt;K&lt;/b&gt;&lt;sub&gt;HPF&lt;/sub&gt; = [ -1, -1, -1 ; -1, 8, -1 ; -1, -1, -1 ]&lt;/font&gt;&lt;br&gt;&lt;font color='#7E22CE' size='1'&gt;Fixed Depthwise Conv3×3 + Sigmoid σ(·)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=1.5;fontColor=#6B21A8;fontSize=11;" parent="1" vertex="1"><mxGeometry x="50" y="275" width="270" height="75" as="geometry" /></mxCell><mxCell id="c_stream_noise" value="&lt;b&gt;Stream B: High-Freq. Residual&lt;/b&gt;&lt;br&gt;&lt;font size='2'&gt;&lt;b&gt;R&lt;/b&gt; = σ(&lt;b&gt;X&lt;/b&gt; * &lt;b&gt;K&lt;/b&gt;&lt;sub&gt;HPF&lt;/sub&gt;) ∈ ℝ&lt;sup&gt;3 × 512 × 512&lt;/sup&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7E22CE' size='1'&gt;Suppresses Handwriting Semantics &amp;amp;&lt;br&gt;Exposes Forensic Boundary Anomalies&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=1.5;fontColor=#7E22CE;fontSize=11;" parent="1" vertex="1"><mxGeometry x="50" y="370" width="270" height="65" as="geometry" /></mxCell><mxCell id="c_dual_concat" value="&lt;b&gt;Channel Concatenation&lt;/b&gt;&lt;br&gt;&lt;font size='2'&gt;&lt;b&gt;X&lt;/b&gt;&lt;sub&gt;dual&lt;/sub&gt; = [ &lt;b&gt;X&lt;/b&gt; ∥ &lt;b&gt;R&lt;/b&gt; ] ∈ ℝ&lt;sup&gt;6 × 512 × 512&lt;/sup&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;fontSize=11;" parent="1" vertex="1"><mxGeometry x="50" y="455" width="270" height="45" as="geometry" /></mxCell><mxCell id="c_conv0" value="&lt;b&gt;Stem Layer (conv0 + pool0)&lt;/b&gt;&lt;br&gt;Conv 7×7 (6 → 64 channels), Stride 2&lt;br&gt;BatchNorm + ReLU + MaxPool 3×3&lt;br&gt;&lt;font color='#16A34A'&gt;&lt;b&gt;Stage 1: s&lt;/b&gt;&lt;sub&gt;1&lt;/sub&gt; ∈ ℝ&lt;sup&gt;64 × 128 × 128&lt;/sup&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#15803D;fontSize=11;" parent="1" vertex="1"><mxGeometry x="390" y="80" width="350" height="65" as="geometry" /></mxCell><mxCell id="c_stage2" value="&lt;b&gt;Dense Block 1 + Transition 1&lt;/b&gt; (6 layers)&lt;br&gt;Direct dense connections: &lt;b&gt;x&lt;/b&gt;&lt;sub&gt;ℓ&lt;/sub&gt; = H&lt;sub&gt;ℓ&lt;/sub&gt;([&lt;b&gt;x&lt;/b&gt;&lt;sub&gt;0&lt;/sub&gt;..&lt;b&gt;x&lt;/b&gt;&lt;sub&gt;ℓ-1&lt;/sub&gt;])&lt;br&gt;&lt;font color='#16A34A'&gt;&lt;b&gt;Stage 2: s&lt;/b&gt;&lt;sub&gt;2&lt;/sub&gt; ∈ ℝ&lt;sup&gt;256 × 64 × 64&lt;/sup&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#15803D;fontSize=11;" parent="1" vertex="1"><mxGeometry x="390" y="165" width="350" height="65" as="geometry" /></mxCell><mxCell id="c_stage3" value="&lt;b&gt;Dense Block 2 + Transition 2&lt;/b&gt; (12 layers)&lt;br&gt;Multi-scale feature reuse across stages&lt;br&gt;&lt;font color='#16A34A'&gt;&lt;b&gt;Stage 3: s&lt;/b&gt;&lt;sub&gt;3&lt;/sub&gt; ∈ ℝ&lt;sup&gt;512 × 32 × 32&lt;/sup&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#15803D;fontSize=11;" parent="1" vertex="1"><mxGeometry x="390" y="250" width="350" height="65" as="geometry" /></mxCell><mxCell id="c_stage4" value="&lt;b&gt;Dense Block 3 + Transition 3&lt;/b&gt; (24 layers)&lt;br&gt;High-level semantic &amp;amp; contextual representations&lt;br&gt;&lt;font color='#16A34A'&gt;&lt;b&gt;Stage 4: s&lt;/b&gt;&lt;sub&gt;4&lt;/sub&gt; ∈ ℝ&lt;sup&gt;1024 × 16 × 16&lt;/sup&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#15803D;fontSize=11;" parent="1" vertex="1"><mxGeometry x="390" y="335" width="350" height="65" as="geometry" /></mxCell><mxCell id="c_stage5" value="&lt;b&gt;Dense Block 4 + Norm5&lt;/b&gt; (16 layers)&lt;br&gt;Bottleneck Encoder Representation&lt;br&gt;&lt;font color='#14532D' size='2'&gt;&lt;b&gt;Stage 5 (Bottleneck): s&lt;/b&gt;&lt;sub&gt;5&lt;/sub&gt; ∈ ℝ&lt;sup&gt;1024 × 8 × 8&lt;/sup&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBF7D0;strokeColor=#15803D;strokeWidth=2;fontColor=#14532D;fontSize=11;" parent="1" vertex="1"><mxGeometry x="390" y="420" width="350" height="65" as="geometry" /></mxCell><mxCell id="c_attn_input" value="&lt;b&gt;Bottleneck Input Feature Map&lt;/b&gt;&lt;br&gt;&lt;b&gt;s&lt;/b&gt;&lt;sub&gt;5&lt;/sub&gt; ∈ ℝ&lt;sup&gt;1024 × 8 × 8&lt;/sup&gt; (N = 64 spatial positions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;strokeWidth=1.5;fontColor=#713F12;fontSize=11;" parent="1" vertex="1"><mxGeometry x="810" y="80" width="320" height="45" as="geometry" /></mxCell><mxCell id="c_attn_q" value="&lt;b&gt;Query (Q)&lt;/b&gt;&lt;br&gt;&lt;b&gt;W&lt;/b&gt;&lt;sub&gt;q&lt;/sub&gt; &lt;b&gt;s&lt;/b&gt;&lt;sub&gt;5&lt;/sub&gt; ∈ ℝ&lt;sup&gt;128 × 64&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1;fontColor=#854D0E;fontSize=10;" parent="1" vertex="1"><mxGeometry x="810" y="145" width="95" height="45" as="geometry" /></mxCell><mxCell id="c_attn_k" value="&lt;b&gt;Key (K)&lt;/b&gt;&lt;br&gt;&lt;b&gt;W&lt;/b&gt;&lt;sub&gt;k&lt;/sub&gt; &lt;b&gt;s&lt;/b&gt;&lt;sub&gt;5&lt;/sub&gt; ∈ ℝ&lt;sup&gt;128 × 64&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1;fontColor=#854D0E;fontSize=10;" parent="1" vertex="1"><mxGeometry x="922" y="145" width="95" height="45" as="geometry" /></mxCell><mxCell id="c_attn_v" value="&lt;b&gt;Value (V)&lt;/b&gt;&lt;br&gt;&lt;b&gt;W&lt;/b&gt;&lt;sub&gt;v&lt;/sub&gt; &lt;b&gt;s&lt;/b&gt;&lt;sub&gt;5&lt;/sub&gt; ∈ ℝ&lt;sup&gt;1024 × 64&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1;fontColor=#854D0E;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1035" y="145" width="95" height="45" as="geometry" /></mxCell><mxCell id="c_attn_mat" value="&lt;b&gt;Scaled Dot-Product &amp;amp; Clamped Softmax&lt;/b&gt;&lt;br&gt;&lt;b&gt;A&lt;/b&gt;&lt;sub&gt;i,j&lt;/sub&gt; = Softmax( clamp( &lt;b&gt;Q&lt;/b&gt;&lt;sup&gt;T&lt;/sup&gt;&lt;b&gt;K&lt;/b&gt; / √d&lt;sub&gt;k&lt;/sub&gt;, -50, +50 ) )&lt;br&gt;&lt;font color='#B45309' size='1'&gt;Captures Non-Local Copy-Move Duplication Across Text Lines&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE047;strokeColor=#CA8A04;strokeWidth=1.5;fontColor=#713F12;fontSize=10;" parent="1" vertex="1"><mxGeometry x="810" y="215" width="320" height="75" as="geometry" /></mxCell><mxCell id="c_attn_agg" value="&lt;b&gt;Value Context Aggregation&lt;/b&gt;&lt;br&gt;&lt;b&gt;O&lt;/b&gt; = &lt;b&gt;V&lt;/b&gt; · &lt;b&gt;A&lt;/b&gt; ∈ ℝ&lt;sup&gt;1024 × 8 × 8&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1;fontColor=#854D0E;fontSize=11;" parent="1" vertex="1"><mxGeometry x="810" y="315" width="320" height="50" as="geometry" /></mxCell><mxCell id="c_attn_out" value="&lt;b&gt;Learnable Residual Combination&lt;/b&gt;&lt;br&gt;&lt;font size='2'&gt;&lt;b&gt;s&lt;/b&gt;&lt;sub&gt;5&lt;/sub&gt;&lt;sup&gt;att&lt;/sup&gt; = γ · &lt;b&gt;O&lt;/b&gt; + &lt;b&gt;s&lt;/b&gt;&lt;sub&gt;5&lt;/sub&gt; ∈ ℝ&lt;sup&gt;1024 × 8 × 8&lt;/sup&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#15803D' size='1'&gt;(Learnable parameter γ initialized to 0 for training stability)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBF7D0;strokeColor=#16A34A;strokeWidth=2;fontColor=#14532D;fontSize=11;" parent="1" vertex="1"><mxGeometry x="810" y="390" width="320" height="75" as="geometry" /></mxCell><mxCell id="c_b1_title" value="&lt;b&gt;BRANCH 1: BINARY FORGERY DETECTION HEAD&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#15803D;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1200" y="80" width="710" height="25" as="geometry" /></mxCell><mxCell id="c_b1_gap" value="&lt;b&gt;GAP&lt;/b&gt;&lt;br&gt;GAP(&lt;b&gt;s&lt;/b&gt;&lt;sub&gt;5&lt;/sub&gt;&lt;sup&gt;att&lt;/sup&gt;)&lt;br&gt;∈ ℝ&lt;sup&gt;1024&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#15803D;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1200" y="115" width="100" height="55" as="geometry" /></mxCell><mxCell id="c_b1_mlp" value="&lt;b&gt;MLP Classification Head&lt;/b&gt;&lt;br&gt;Linear(1024 → 256) → ReLU → Dropout(0.5)&lt;br&gt;Linear(256 → 1) → Sigmoid σ(·)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#15803D;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1320" y="115" width="270" height="55" as="geometry" /></mxCell><mxCell id="c_b1_out" value="&lt;b&gt;Binary Forgery Logit&lt;/b&gt;&lt;br&gt;&lt;font size='2'&gt;&lt;b&gt;ŷ&lt;/b&gt;&lt;sub&gt;det&lt;/sub&gt; ∈ [0, 1]&lt;/font&gt;&lt;br&gt;&lt;font color='#16A34A'&gt;&lt;b&gt;Authentic (0) vs. Forged (1)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#0284C7' size='1'&gt;Test Acc: &lt;b&gt;89.39%&lt;/b&gt; | ROC-AUC: &lt;b&gt;0.9446&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontColor=#14532D;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1610" y="110" width="300" height="65" as="geometry" /></mxCell><mxCell id="c_b1_loss" value="&lt;b&gt;Branch 1 Loss&lt;/b&gt;: Balanced Weighted BCE (w&lt;sub&gt;det&lt;/sub&gt; = 0.33, λ&lt;sub&gt;det&lt;/sub&gt; = 1.0) — Achieved 100% Specificity (35/35 Authentic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=1;fontColor=#166534;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1200" y="185" width="710" height="25" as="geometry" /></mxCell><mxCell id="c_b3_title" value="&lt;b&gt;BRANCH 3: TAMPERING TAXONOMY CATEGORIZATION HEAD&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=1.5;fontColor=#9D174D;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1200" y="230" width="710" height="25" as="geometry" /></mxCell><mxCell id="c_b3_fuse" value="&lt;b&gt;Dual-Feature Fusion&lt;/b&gt;&lt;br&gt;&lt;b&gt;f&lt;/b&gt;&lt;sub&gt;type&lt;/sub&gt; = [ GAP(&lt;b&gt;s&lt;/b&gt;&lt;sub&gt;5&lt;/sub&gt;&lt;sup&gt;att&lt;/sup&gt;) ∥ GAP(Bridge) ] ∈ ℝ&lt;sup&gt;1536&lt;/sup&gt;&lt;br&gt;&lt;font color='#9D174D' size='1'&gt;Combines Global Document Semantics (1024) + Decoder Bridge Latents (512)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DB2777;strokeWidth=1.5;fontColor=#9D174D;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1200" y="265" width="390" height="60" as="geometry" /></mxCell><mxCell id="c_b3_mlp" value="&lt;b&gt;Multi-Class Classifier&lt;/b&gt;&lt;br&gt;Linear(1536 → 512) → ReLU → Dropout(0.5)&lt;br&gt;Linear(512 → 3) → Softmax" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DB2777;strokeWidth=1.5;fontColor=#9D174D;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1610" y="265" width="300" height="60" as="geometry" /></mxCell><mxCell id="c_b3_out" value="&lt;b&gt;Categorical Probability Distribution&lt;/b&gt;: &lt;b&gt;ŷ&lt;/b&gt;&lt;sub&gt;type&lt;/sub&gt; ∈ Δ&lt;sup&gt;2&lt;/sup&gt;&lt;br&gt;1. &lt;b&gt;Copy-Move&lt;/b&gt; (F1: 0.62) &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; 2. &lt;b&gt;Splicing&lt;/b&gt; (F1: 0.78) &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; 3. &lt;b&gt;Character Addition&lt;/b&gt; (F1: &lt;b&gt;1.00&lt;/b&gt;)&lt;br&gt;&lt;font color='#9D174D' size='1'&gt;Macro F1: &lt;b&gt;0.8005&lt;/b&gt; &amp;nbsp;|&amp;nbsp; 3-Class Categorization Accuracy: &lt;b&gt;82.47%&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#BE185D;strokeWidth=2;fontColor=#831843;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1200" y="340" width="710" height="60" as="geometry" /></mxCell><mxCell id="c_b3_loss" value="&lt;b&gt;Branch 3 Loss&lt;/b&gt;: Masked Cross-Entropy (Computed selectively over verified manipulated patches, λ&lt;sub&gt;type&lt;/sub&gt; = 1.0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#F472B6;strokeWidth=1;fontColor=#9D174D;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1200" y="410" width="710" height="25" as="geometry" /></mxCell><mxCell id="c_total_loss" value="&lt;b&gt;TOTAL END-TO-END MULTI-TASK LOSS OBJECTIVE&lt;/b&gt;: &amp;nbsp;&amp;nbsp; ℒ&lt;sub&gt;total&lt;/sub&gt; = 1.0 · ℒ&lt;sub&gt;det&lt;/sub&gt; + 4.0 · ℒ&lt;sub&gt;loc&lt;/sub&gt; + 1.0 · ℒ&lt;sub&gt;type&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1200" y="450" width="710" height="35" as="geometry" /></mxCell><mxCell id="c_dec_bridge" value="&lt;b&gt;Decoder Bridge&lt;/b&gt;&lt;br&gt;Conv 3×3 (1024 → 512)&lt;br&gt;BatchNorm + ReLU&lt;br&gt;&lt;font color='#1E40AF'&gt;&lt;b&gt;b&lt;/b&gt; ∈ ℝ&lt;sup&gt;512 × 8 × 8&lt;/sup&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1E40AF;fontSize=10;" parent="1" vertex="1"><mxGeometry x="50" y="700" width="180" height="85" as="geometry" /></mxCell><mxCell id="c_dec_up4" value="&lt;b&gt;Decoder Stage 4&lt;/b&gt;&lt;br&gt;ConvTrans (512 → 256, 16×16)&lt;br&gt;&lt;font color='#D97706'&gt;[ Concat Skip &lt;b&gt;s&lt;/b&gt;&lt;sub&gt;4&lt;/sub&gt; (1024) ]&lt;/font&gt;&lt;br&gt;Dual Conv 3×3 + BN + ReLU&lt;br&gt;&lt;font color='#1E40AF'&gt;&lt;b&gt;d&lt;/b&gt;&lt;sub&gt;4&lt;/sub&gt; ∈ ℝ&lt;sup&gt;512 × 16 × 16&lt;/sup&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1E40AF;fontSize=10;" parent="1" vertex="1"><mxGeometry x="260" y="700" width="210" height="95" as="geometry" /></mxCell><mxCell id="c_dec_up3" value="&lt;b&gt;Decoder Stage 3&lt;/b&gt;&lt;br&gt;ConvTrans (512 → 256, 32×32)&lt;br&gt;&lt;font color='#D97706'&gt;[ Concat Skip &lt;b&gt;s&lt;/b&gt;&lt;sub&gt;3&lt;/sub&gt; (512) ]&lt;/font&gt;&lt;br&gt;Dual Conv 3×3 + BN + ReLU&lt;br&gt;&lt;font color='#1E40AF'&gt;&lt;b&gt;d&lt;/b&gt;&lt;sub&gt;3&lt;/sub&gt; ∈ ℝ&lt;sup&gt;256 × 32 × 32&lt;/sup&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1E40AF;fontSize=10;" parent="1" vertex="1"><mxGeometry x="500" y="700" width="210" height="95" as="geometry" /></mxCell><mxCell id="c_dec_up2" value="&lt;b&gt;Decoder Stage 2&lt;/b&gt;&lt;br&gt;ConvTrans (256 → 128, 64×64)&lt;br&gt;&lt;font color='#D97706'&gt;[ Concat Skip &lt;b&gt;s&lt;/b&gt;&lt;sub&gt;2&lt;/sub&gt; (256) ]&lt;/font&gt;&lt;br&gt;Dual Conv 3×3 + BN + ReLU&lt;br&gt;&lt;font color='#1E40AF'&gt;&lt;b&gt;d&lt;/b&gt;&lt;sub&gt;2&lt;/sub&gt; ∈ ℝ&lt;sup&gt;128 × 64 × 64&lt;/sup&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1E40AF;fontSize=10;" parent="1" vertex="1"><mxGeometry x="740" y="700" width="210" height="95" as="geometry" /></mxCell><mxCell id="c_dec_up1" value="&lt;b&gt;Decoder Stage 1&lt;/b&gt;&lt;br&gt;ConvTrans (128 → 64, 128×128)&lt;br&gt;&lt;font color='#D97706'&gt;[ Concat Skip &lt;b&gt;s&lt;/b&gt;&lt;sub&gt;1&lt;/sub&gt; (64) ]&lt;/font&gt;&lt;br&gt;Dual Conv 3×3 + BN + ReLU&lt;br&gt;&lt;font color='#1E40AF'&gt;&lt;b&gt;d&lt;/b&gt;&lt;sub&gt;1&lt;/sub&gt; ∈ ℝ&lt;sup&gt;64 × 128 × 128&lt;/sup&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1E40AF;fontSize=10;" parent="1" vertex="1"><mxGeometry x="980" y="700" width="210" height="95" as="geometry" /></mxCell><mxCell id="c_dec_head" value="&lt;b&gt;Segmentation Head&lt;/b&gt;&lt;br&gt;ConvTrans (64 → 32, 256×256)&lt;br&gt;ReLU → Conv 1×1 (32 → 1, 512×512)&lt;br&gt;Sigmoid Activation σ(·)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#1E3A8A;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1220" y="700" width="220" height="95" as="geometry" /></mxCell><mxCell id="c_dec_out" value="&lt;b&gt;Dense Pixel-Level Stroke Localization Mask&lt;/b&gt;&lt;br&gt;&lt;font size='3'&gt;&lt;b&gt;M̂&lt;/b&gt;&lt;sub&gt;loc&lt;/sub&gt; ∈ [0, 1]&lt;sup&gt;512 × 512&lt;/sup&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#1E40AF'&gt;&lt;b&gt;Sub-millimeter Tampered Handwriting Stroke Boundaries&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#0284C7' size='1'&gt;Raw Model mDice: &lt;b&gt;0.3330&lt;/b&gt; | Eliminates Baseline Segmentation Collapse&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#1D4ED8;strokeWidth=2.5;fontColor=#1E3A8A;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1470" y="700" width="440" height="95" as="geometry" /></mxCell><mxCell id="c_dec_loss" value="&lt;b&gt;Branch 2 Localization Objective&lt;/b&gt;: Asymmetric Focal Tversky Loss (α = 0.7, β = 0.3) + Positive-Weighted BCE (w&lt;sub&gt;loc&lt;/sub&gt; = 15.0, λ&lt;sub&gt;loc&lt;/sub&gt; = 4.0)&lt;br&gt;&lt;font color='#1E40AF' size='1'&gt;Penalizes False Negatives on sparse ink strokes 2.3× harder than False Positives, overcoming severe spatial sparsity (&amp;lt;1% tampered ink)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=1.5;fontColor=#1E40AF;fontSize=10;" parent="1" vertex="1"><mxGeometry x="50" y="830" width="1860" height="50" as="geometry" /></mxCell><mxCell id="c_legend" value="&lt;b&gt;LEGEND &amp;amp; FLOW CONVENTIONS&lt;/b&gt;: &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color='#0284C7'&gt;━━━━▶ Direct Feed-Forward Path&lt;/font&gt; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color='#9333EA'&gt;━━━━▶ High-Frequency Noise Residual Stream&lt;/font&gt; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color='#D97706'&gt;- - - ▶ Encoder Skip Connections (&lt;b&gt;s&lt;/b&gt;&lt;sub&gt;1&lt;/sub&gt;, &lt;b&gt;s&lt;/b&gt;&lt;sub&gt;2&lt;/sub&gt;, &lt;b&gt;s&lt;/b&gt;&lt;sub&gt;3&lt;/sub&gt;, &lt;b&gt;s&lt;/b&gt;&lt;sub&gt;4&lt;/sub&gt;)&lt;/f
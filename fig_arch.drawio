<mxfile host="app.diagrams.net" modified="2026-10-27T11:45:00.000Z" agent="Antigravity" version="21.0.0" type="device"><diagram id="ForgeryNet_Arch" name="Fig. 1 ForgeryNet Architecture"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1150" math="1" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="grp_dual" value="&lt;b&gt;DUAL-STREAM RESIDUAL EXTRACTOR&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;fillColor=#F8F9FA;strokeColor=#B0BEC5;strokeWidth=1.5;fontColor=#37474F;fontSize=13;fontStyle=1;align=center;verticalAlign=top;startSize=28;collapsible=0;" parent="1" vertex="1"><mxGeometry x="30" y="40" width="310" height="480" as_="geometry" /></mxCell><mxCell id="grp_encoder" value="&lt;b&gt;DENSENET-121 HIERARCHICAL BACKBONE ENCODER&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=1.5;fontColor=#166534;fontSize=13;fontStyle=1;align=center;verticalAlign=top;startSize=28;collapsible=0;" parent="1" vertex="1"><mxGeometry x="370" y="40" width="400" height="480" as_="geometry" /></mxCell><mxCell id="grp_attn" value="&lt;b&gt;SPATIAL SELF-ATTENTION BOTTLENECK&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;fillColor=#FEFCE8;strokeColor=#FDE047;strokeWidth=1.5;fontColor=#854D0E;fontSize=13;fontStyle=1;align=center;verticalAlign=top;startSize=28;collapsible=0;" parent="1" vertex="1"><mxGeometry x="800" y="40" width="360" height="480" as_="geometry" /></mxCell><mxCell id="grp_heads" value="&lt;b&gt;MULTI-TASK TASK HEADS (BRANCH 1 &amp;amp; BRANCH 3)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;fillColor=#FAF5FF;strokeColor=#D8B4FE;strokeWidth=1.5;fontColor=#6B21A8;fontSize=13;fontStyle=1;align=center;verticalAlign=top;startSize=28;collapsible=0;" parent="1" vertex="1"><mxGeometry x="1190" y="40" width="680" height="480" as_="geometry" /></mxCell><mxCell id="grp_decoder" value="&lt;b&gt;BRANCH 2: STROKE-LEVEL LOCALIZATION U-NET DECODER (4-STAGE WITH SKIP CONNECTIONS)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.5;fontColor=#1E40AF;fontSize=13;fontStyle=1;align=center;verticalAlign=top;startSize=28;collapsible=0;" parent="1" vertex="1"><mxGeometry x="370" y="560" width="1500" height="420" as_="geometry" /></mxCell><mxCell id="c_input" value="&lt;b&gt;High-Res Document Patch&lt;/b&gt;&lt;br&gt;$$\mathbf{X} \in \mathbb{R}^{3 \times 512 \times 512}$$&lt;br&gt;&lt;font color='#64748B'&gt;Native Scan Fidelity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;fontColor=#0F172A;fontSize=11;" parent="1" vertex="1"><mxGeometry x="50" y="85" width="270" height="65" as_="geometry" /></mxCell><mxCell id="c_stream_rgb" value="&lt;b&gt;Stream A: Visual Appearance&lt;/b&gt;&lt;br&gt;$$\mathbf{X} \in \mathbb{R}^{3 \times 512 \times 512}$$&lt;br&gt;&lt;font color='#0369A1'&gt;Standard RGB Photometric Features&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=1.5;fontColor=#0369A1;fontSize=11;" parent="1" vertex="1"><mxGeometry x="50" y="185" width="270" height="65" as_="geometry" /></mxCell><mxCell id="c_hpf_kernel" value="&lt;b&gt;Depthwise Laplacian Filter&lt;/b&gt;&lt;br&gt;$$\mathbf{K}_{\text{HPF}} = \begin{bmatrix} -1 &amp; -1 &amp; -1 \\ -1 &amp; 8 &amp; -1 \\ -1 &amp; -1 &amp; -1 \end{bmatrix}$$&lt;br&gt;&lt;font color='#7E22CE'&gt;$\sigma(\mathbf{X} * \mathbf{K}_{\text{HPF}})$ Depthwise Conv&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=1.5;fontColor=#6B21A8;fontSize=11;" parent="1" vertex="1"><mxGeometry x="50" y="275" width="270" height="75" as_="geometry" /></mxCell><mxCell id="c_stream_noise" value="&lt;b&gt;Stream B: High-Freq. Residual&lt;/b&gt;&lt;br&gt;$$\mathbf{R} \in \mathbb{R}^{3 \times 512 \times 512}$$&lt;br&gt;&lt;font color='#7E22CE'&gt;Suppresses Ink Semantics &amp;amp;&lt;br&gt;Exposes Tampering Micro-Edges&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=1.5;fontColor=#7E22CE;fontSize=11;" parent="1" vertex="1"><mxGeometry x="50" y="370" width="270" height="65" as_="geometry" /></mxCell><mxCell id="c_dual_concat" value="&lt;b&gt;Channel Concatenation&lt;/b&gt;&lt;br&gt;$$[\mathbf{X} \,\|\, \mathbf{R}] \rightarrow \mathbf{X}_{\text{dual}} \in \mathbb{R}^{6 \times 512 \times 512}$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;fontSize=11;" parent="1" vertex="1"><mxGeometry x="50" y="455" width="270" height="50" as_="geometry" /></mxCell><mxCell id="c_conv0" value="&lt;b&gt;Stem (conv0 + pool0)&lt;/b&gt;&lt;br&gt;Conv $7\times 7$ ($6 \rightarrow 64$), Stride 2&lt;br&gt;BatchNorm + ReLU + MaxPool $3\times 3$&lt;br&gt;$$\mathbf{s}_1 \in \mathbb{R}^{64 \times 128 \times 128}$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#15803D;fontSize=11;" parent="1" vertex="1"><mxGeometry x="390" y="80" width="360" height="65" as_="geometry" /></mxCell><mxCell id="c_stage2" value="&lt;b&gt;Dense Block 1 + Trans 1&lt;/b&gt; (6 layers)&lt;br&gt;Direct dense connections: $\mathbf{x}_\ell = H_\ell([\mathbf{x}_0..\mathbf{x}_{\ell-1}])$&lt;br&gt;$$\mathbf{s}_2 \in \mathbb{R}^{256 \times 64 \times 64}$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#15803D;fontSize=11;" parent="1" vertex="1"><mxGeometry x="390" y="165" width="360" height="65" as_="geometry" /></mxCell><mxCell id="c_stage3" value="&lt;b&gt;Dense Block 2 + Trans 2&lt;/b&gt; (12 layers)&lt;br&gt;Feature reuse &amp;amp; multi-scale context&lt;br&gt;$$\mathbf{s}_3 \in \mathbb{R}^{512 \times 32 \times 32}$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#15803D;fontSize=11;" parent="1" vertex="1"><mxGeometry x="390" y="250" width="360" height="65" as_="geometry" /></mxCell><mxCell id="c_stage4" value="&lt;b&gt;Dense Block 3 + Trans 3&lt;/b&gt; (24 layers)&lt;br&gt;High-level semantic and forgery patterns&lt;br&gt;$$\mathbf{s}_4 \in \mathbb{R}^{1024 \times 16 \times 16}$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#15803D;fontSize=11;" parent="1" vertex="1"><mxGeometry x="390" y="335" width="360" height="65" as_="geometry" /></mxCell><mxCell id="c_stage5" value="&lt;b&gt;Dense Block 4 + Norm5&lt;/b&gt; (16 layers)&lt;br&gt;Bottleneck Encoder Representation&lt;br&gt;$$\mathbf{s}_5 \in \mathbb{R}^{1024 \times 8 \times 8}$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBF7D0;strokeColor=#15803D;strokeWidth=2;fontColor=#14532D;fontSize=11;" parent="1" vertex="1"><mxGeometry x="390" y="420" width="360" height="65" as_="geometry" /></mxCell><mxCell id="c_attn_input" value="&lt;b&gt;Bottleneck Input&lt;/b&gt;: $$\mathbf{s}_5 \in \mathbb{R}^{1024 \times 8 \times 8}$$ ($N = 64$ tokens)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;strokeWidth=1.5;fontColor=#713F12;fontSize=11;" parent="1" vertex="1"><mxGeometry x="820" y="80" width="320" height="45" as_="geometry" /></mxCell><mxCell id="c_attn_q" value="$$\mathbf{Q} = \mathbf{W}_q \mathbf{s}_5$$&lt;br&gt;$\mathbb{R}^{128 \times 64}$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1;fontColor=#854D0E;fontSize=10;" parent="1" vertex="1"><mxGeometry x="820" y="145" width="95" height="45" as_="geometry" /></mxCell><mxCell id="c_attn_k" value="$$\mathbf{K} = \mathbf{W}_k \mathbf{s}_5$$&lt;br&gt;$\mathbb{R}^{128 \times 64}$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1;fontColor=#854D0E;fontSize=10;" parent="1" vertex="1"><mxGeometry x="932" y="145" width="95" height="45" as_="geometry" /></mxCell><mxCell id="c_attn_v" value="$$\mathbf{V} = \mathbf{W}_v \mathbf{s}_5$$&lt;br&gt;$\mathbb{R}^{1024 \times 64}$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1;fontColor=#854D0E;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1045" y="145" width="95" height="45" as_="geometry" /></mxCell><mxCell id="c_attn_mat" value="&lt;b&gt;Scaled Dot-Product &amp;amp; Clamped Softmax&lt;/b&gt;&lt;br&gt;$$\mathbf{A}_{i,j} = \text{Softmax}\left(\text{clamp}\left(\frac{\mathbf{Q}^T \mathbf{K}}{\sqrt{C'}}, -50, 50\right)\right)$$&lt;br&gt;&lt;font color='#B45309'&gt;Captures Non-Local Copy-Move Text Correlations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE047;strokeColor=#CA8A04;strokeWidth=1.5;fontColor=#713F12;fontSize=10;" parent="1" vertex="1"><mxGeometry x="820" y="215" width="320" height="75" as_="geometry" /></mxCell><mxCell id="c_attn_agg" value="&lt;b&gt;Value Context Aggregation&lt;/b&gt;&lt;br&gt;$$\mathbf{O} = \mathbf{V} \mathbf{A} \in \mathbb{R}^{1024 \times 8 \times 8}$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1;fontColor=#854D0E;fontSize=11;" parent="1" vertex="1"><mxGeometry x="820" y="315" width="320" height="50" as_="geometry" /></mxCell><mxCell id="c_attn_out" value="&lt;b&gt;Learnable Residual Combination&lt;/b&gt;&lt;br&gt;$$\mathbf{s}_5^{\text{att}} = \gamma \cdot \mathbf{O} + \mathbf{s}_5 \in \mathbb{R}^{1024 \times 8 \times 8}$$&lt;br&gt;&lt;font color='#15803D'&gt;($\gamma$ initialized to 0 for stability)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBF7D0;strokeColor=#16A34A;strokeWidth=2;fontColor=#14532D;fontSize=11;" parent="1" vertex="1"><mxGeometry x="820" y="390" width="320" height="75" as_="geometry" /></mxCell><mxCell id="c_b1_title" value="&lt;b&gt;BRANCH 1: BINARY FORGERY DETECTION HEAD&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#15803D;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1210" y="80" width="640" height="25" as_="geometry" /></mxCell><mxCell id="c_b1_gap" value="$$\text{GAP}(\mathbf{s}_5^{\text{att}})$$&lt;br&gt;$\mathbb{R}^{1024}$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#15803D;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1210" y="115" width="110" height="55" as_="geometry" /></mxCell><mxCell id="c_b1_mlp" value="&lt;b&gt;MLP Classifier&lt;/b&gt;&lt;br&gt;Linear($1024 \rightarrow 256$) $\rightarrow$ ReLU&lt;br&gt;Dropout($0.5$) $\rightarrow$ Linear($256 \rightarrow 1$)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#15803D;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1340" y="115" width="230" height="55" as_="geometry" /></mxCell><mxCell id="c_b1_out" value="&lt;b&gt;Detection Logit&lt;/b&gt;&lt;br&gt;$$\hat{y}_{\text{det}} = \sigma(\mathbf{z}_{\text{det}}) \in [0, 1]$$&lt;br&gt;&lt;font color='#16A34A'&gt;&lt;b&gt;Authentic (0) vs. Forged (1)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#0284C7'&gt;Acc: 89.39% | AUC: 0.9446&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontColor=#14532D;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1590" y="105" width="260" height="75" as_="geometry" /></mxCell><mxCell id="c_b1_loss" value="&lt;b&gt;Branch 1 Loss&lt;/b&gt;: Weighted BCE ($w_{\text{det}} = 0.33$, $\lambda_{\text{det}} = 1.0$)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=1;fontColor=#166534;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1340" y="180" width="510" height="25" as_="geometry" /></mxCell><mxCell id="c_b3_title" value="&lt;b&gt;BRANCH 3: TAMPERING TAXONOMY CATEGORIZATION HEAD&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=1.5;fontColor=#9D174D;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1210" y="230" width="640" height="25" as_="geometry" /></mxCell><mxCell id="c_b3_fuse" value="&lt;b&gt;Dual-Feature Fusion&lt;/b&gt;&lt;br&gt;$$\mathbf{f}_{\text{type}} = [\text{GAP}(\mathbf{s}_5^{\text{att}}) \,\|\, \text{GAP}(\text{Bridge})] \in \mathbb{R}^{1536}$$&lt;br&gt;&lt;font color='#9D174D'&gt;Combines Global Document Semantics + Decoder Latents&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DB2777;strokeWidth=1.5;fontColor=#9D174D;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1210" y="265" width="350" height="65" as_="geometry" /></mxCell><mxCell id="c_b3_mlp" value="&lt;b&gt;Multi-Class Classifier&lt;/b&gt;&lt;br&gt;Linear($1536 \rightarrow 512$) $\rightarrow$ ReLU $\rightarrow$ Dropout($0.5$)&lt;br&gt;Linear($512 \rightarrow 3$) $\rightarrow$ Softmax" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DB2777;strokeWidth=1.5;fontColor=#9D174D;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1580" y="265" width="270" height="65" as_="geometry" /></mxCell><mxCell id="c_b3_out" value="&lt;b&gt;Tampering Class Probabilities&lt;/b&gt;: $$\hat{\mathbf{y}}_{\text{type}} \in \Delta^2$$&lt;br&gt;1. &lt;b&gt;Copy-Move&lt;/b&gt; (F1: 0.62) &amp;nbsp;|&amp;nbsp; 2. &lt;b&gt;Splicing&lt;/b&gt; (F1: 0.78)&lt;br&gt;3. &lt;b&gt;Character Addition&lt;/b&gt; (F1: &lt;b&gt;1.00&lt;/b&gt;)&lt;br&gt;&lt;font color='#9D174D'&gt;Macro F1: &lt;b&gt;0.8005&lt;/b&gt; | Multi-Class Acc: &lt;b&gt;82.47%&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#BE185D;strokeWidth=2;fontColor=#831843;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1210" y="345" width="640" height="65" as_="geometry" /></mxCell><mxCell id="c_b3_loss" value="&lt;b&gt;Branch 3 Loss&lt;/b&gt;: Masked Cross-Entropy (Computed only on tampered patches, $\lambda_{\text{type}} = 1.0$)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#F472B6;strokeWidth=1;fontColor=#9D174D;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1210" y="420" width="640" height="25" as_="geometry" /></mxCell><mxCell id="c_total_loss" value="&lt;b&gt;JOINT MULTI-TASK LOSS OBJECTIVE&lt;/b&gt;: $$\mathcal{L}_{\text{total}} = 1.0 \cdot \mathcal{L}_{\text{det}} + 4.0 \cdot \mathcal{L}_{\text{loc}} + 1.0 \cdot \mathcal{L}_{\text{type}}$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1210" y="460" width="640" height="35" as_="geometry" /></mxCell><mxCell id="c_dec_bridge" value="&lt;b&gt;Decoder Bridge&lt;/b&gt;&lt;br&gt;Conv $3\times 3$ ($1024 \rightarrow 512$)&lt;br&gt;BatchNorm + ReLU&lt;br&gt;$$\mathbf{b} \in \mathbb{R}^{512 \times 8 \times 8}$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1E40AF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="390" y="610" width="170" height="75" as_="geometry" /></mxCell><mxCell id="c_dec_up4" value="&lt;b&gt;Decoder Stage 4&lt;/b&gt;&lt;br&gt;ConvTrans ($512 \rightarrow 256$, $16\times 16$)&lt;br&gt;$$\oplus$$ &lt;b&gt;Skip $\mathbf{s}_4$&lt;/b&gt; ($1024\times 16\times 16$)&lt;br&gt;Dual Conv $3\times 3$ + BN + ReLU&lt;br&gt;$$\mathbf{d}_4 \in \mathbb{R}^{512 \times 16 \times 16}$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1E40AF;fontSize=10;" parent="1" vertex="1"><mxGeometry x="600" y="610" width="210" height="95" as_="geometry" /></mxCell><mxCell id="c_dec_up3" value="&lt;b&gt;Decoder Stage 3&lt;/b&gt;&lt;br&gt;ConvTrans ($512 \rightarrow 256$, $32\times 32$)&lt;br&gt;$$\oplus$$ &lt;b&gt;Skip $\mathbf{s}_3$&lt;/b&gt; ($512\times 32\times 32$)&lt;br&gt;Dual Conv $3\times 3$ + BN + ReLU&lt;br&gt;$$\mathbf{d}_3 \in \mathbb{R}^{256 \times 32 \times 32}$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1E40AF;fontSize=10;" parent="1" vertex="1"><mxGeometry x="850" y="610" width="210" height="95" as_="geometry" /></mxCell><mxCell id="c_dec_up2" value="&lt;b&gt;Decoder Stage 2&lt;/b&gt;&lt;br&gt;ConvTrans ($256 \rightarrow 128$, $64\times 64$)&lt;br&gt;$$\oplus$$ &lt;b&gt;Skip $\mathbf{s}_2$&lt;/b&gt; ($256\times 64\times 64$)&lt;br&gt;Dual Conv $3\times 3$ + BN + ReLU&lt;br&gt;$$\mathbf{d}_2 \in \mathbb{R}^{128 \times 64 \times 64}$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1E40AF;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1100" y="610" width="210" height="95" as_="geometry" /></mxCell><mxCell id="c_dec_up1" value="&lt;b&gt;Decoder Stage 1&lt;/b&gt;&lt;br&gt;ConvTrans ($128 \rightarrow 64$, $128\times 128$)&lt;br&gt;$$\oplus$$ &lt;b&gt;Skip $\mathbf{s}_1$&lt;/b&gt; ($64\times 128\times 128$)&lt;br&gt;Dual Conv $3\times 3$ + BN + ReLU&lt;br&gt;$$\mathbf{d}_1 \in \mathbb{R}^{64 \times 128 \times 128}$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1E40AF;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1350" y="610" width="210" height="95" as_="geometry" /></mxCell><mxCell id="c_dec_head" value="&lt;b&gt;Segmentation Head&lt;/b&gt;&lt;br&gt;ConvTrans ($64 \rightarrow 32$, $256\times 256$)&lt;br&gt;ReLU $\rightarrow$ Conv $1\times 1$ ($32 \rightarrow 1$, $512\times 512$)&lt;br&gt;$$\sigma(\cdot)$$ Sigmoid Activation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#1E3A8A;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1600" y="610" width="240" height="95" as_="geometry" /></mxCell><mxCell id="c_dec_out" value="&lt;b&gt;Dense Stroke Localization Mask&lt;/b&gt;&lt;br&gt;$$\hat{\mathbf{M}}_{\text{loc}} \in [0, 1]^{512 \times 512}$$&lt;br&gt;&lt;font color='#1E40AF'&gt;&lt;b&gt;Sub-millimeter Tampered Stroke Boundaries&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#0284C7'&gt;Raw mDice: &lt;b&gt;0.3330&lt;/b&gt; | Eliminates Background Collapse&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#1D4ED8;strokeWidth=2.5;fontColor=#1E3A8A;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1350" y="740" width="490" height="80" as_="geometry" /></mxCell><mxCell id="c_dec_loss" value="&lt;b&gt;Branch 2 Localization Objective&lt;/b&gt;: Asymmetric Focal Tversky Loss ($\alpha = 0.7, \beta = 0.3$) + Positive-Weighted BCE ($w_{\text{loc}} = 15.0$, $\lambda_{\text{loc}} = 4.0$)&lt;br&gt;&lt;font color='#1E40AF'&gt;Overcomes extreme foreground sparsity (&amp;lt;1% tampered pixels) and prevents all-zero trivial predictions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=1.5;fontColor=#1E40AF;fontSize=10;" parent="1" vertex="1"><mxGeometry x="410" y="740" width="910" height="60" as_="geometry" /></mxCell><mxCell id="c_legend" value="&lt;b&gt;LEGEND &amp;amp; FLOW CONVENTIONS&lt;/b&gt;: &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color='#0284C7'&gt;&amp;#9644;&amp;#9644;&amp;#9658; Feed-Forward Backbone Path&lt;/font&gt; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color='#9333EA'&gt;&amp;#9644;&amp;#9644;&amp;#9658; High-Frequency Noise Residual Stream&lt;/font&gt; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color='#D97706'&gt;- - - &amp;#9658; Skip Connections ($\mathbf{s}_1, \mathbf{s}_2, \mathbf{s}_3, \mathbf{s}_4$)&lt;/font&gt; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color='#16A34A'&gt;&amp;#9644;&amp;#9644;&amp;#9658; Multi-Task Branch Projections&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1;fontColor=#334155;fo